# Copy to .env and adjust. Every variable is optional for local development.
HOTELBOT_ENV=dev                       # dev | test | prod
HOTELBOT_LOG_LEVEL=INFO

# Database (docker-compose sets this for the api container)
HOTELBOT_DATABASE_URL=sqlite:///./hotelbot.db
# HOTELBOT_DATABASE_URL=postgresql+psycopg://hotelbot:hotelbot@localhost:5432/hotelbot

# Hotel knowledge pack (SYNTHETIC example data - replace with the real pack)
HOTELBOT_HOTEL_SLUG=example-hotel
HOTELBOT_KNOWLEDGE_PATH=data/hotel/example_hotel.yaml
HOTELBOT_GROUNDING_MIN_SCORE=0.5

# LLM: none | openai | anthropic   ("none" = extractive answers, no external calls)
HOTELBOT_LLM_PROVIDER=none
HOTELBOT_LLM_MODEL=
HOTELBOT_LLM_TIMEOUT_SECONDS=20
HOTELBOT_OPENAI_API_KEY=
HOTELBOT_OPENAI_BASE_URL=https://api.openai.com/v1
HOTELBOT_ANTHROPIC_API_KEY=

# WhatsApp: mock | meta
HOTELBOT_WHATSAPP_TRANSPORT=mock
HOTELBOT_WHATSAPP_VERIFY_TOKEN=change-me
HOTELBOT_WHATSAPP_APP_SECRET=
HOTELBOT_WHATSAPP_ACCESS_TOKEN=
HOTELBOT_WHATSAPP_PHONE_NUMBER_ID=
HOTELBOT_WHATSAPP_GRAPH_VERSION=v21.0

# Staff API shared token (required outside dev)
HOTELBOT_STAFF_API_TOKEN=change-me

HOTELBOT_ENABLE_DEMO_ENDPOINTS=true
