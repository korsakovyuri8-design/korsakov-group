# Copy to .env and adjust. Every variable is optional for local development.
HOTELBOT_ENV=dev                       # dev | test | prod
HOTELBOT_LOG_LEVEL=INFO

# Database (docker-compose sets this for the api container)
HOTELBOT_DATABASE_URL=sqlite:///./hotelbot.db
# HOTELBOT_DATABASE_URL=postgresql+psycopg://hotelbot:hotelbot@localhost:5432/hotelbot

# Property packs (SYNTHETIC example data - replace with real packs)
HOTELBOT_PROPERTY_SLUG=example-hotel          # default property (HOTELBOT_HOTEL_SLUG also works)
HOTELBOT_KNOWLEDGE_PATH=data/hotel/example_hotel.yaml
HOTELBOT_EXTRA_PACK_PATHS=["data/properties/demo_apartment.yaml"]
HOTELBOT_GROUNDING_MIN_SCORE=0.5

# Migrations: apply Alembic migrations on startup for existing databases
HOTELBOT_AUTO_MIGRATE=true

# LLM: none | openai | anthropic   ("none" = extractive answers, no external calls)
HOTELBOT_LLM_PROVIDER=none
HOTELBOT_LLM_MODEL=
HOTELBOT_LLM_TIMEOUT_SECONDS=20
HOTELBOT_OPENAI_API_KEY=
HOTELBOT_OPENAI_BASE_URL=https://api.openai.com/v1
HOTELBOT_ANTHROPIC_API_KEY=

# WhatsApp: mock | meta
HOTELBOT_WHATSAPP_TRANSPORT=mock
HOTELBOT_WHATSAPP_VERIFY_TOKEN=change-me
HOTELBOT_WHATSAPP_APP_SECRET=
HOTELBOT_WHATSAPP_ACCESS_TOKEN=
HOTELBOT_WHATSAPP_PHONE_NUMBER_ID=
HOTELBOT_WHATSAPP_GRAPH_VERSION=v21.0

# Staff API shared token (required outside dev)
HOTELBOT_STAFF_API_TOKEN=change-me

HOTELBOT_ENABLE_DEMO_ENDPOINTS=true

# Handoff policy: consecutive unhelpful turns before escalating (default),
# plus per-intent overrides. Property packs may override both (policy: ...).
HOTELBOT_MAX_CONSECUTIVE_FAILURES=2
HOTELBOT_FAILURE_THRESHOLDS={}

# Background worker (outbox: provider calls, notifications, inbound WhatsApp).
# false = run `python -m app.worker` as separate process(es) instead.
HOTELBOT_WORKER_ENABLED=true
HOTELBOT_WORKER_POLL_SECONDS=1.0

# Local travel data (SYNTHETIC demo region - replace with verified data)
HOTELBOT_REGION_PACK_PATHS=["data/regions/zabljak_demo.yaml"]

# Provider secrets are referenced by NAME from packs (`*_env` keys) and never
# stored in pack files. Demo providers:
DEMO_TRANSFERS_CALLBACK_SECRET=change-me
DEMO_TABLES_CALLBACK_SECRET=change-me
DEMO_PREMIUM_CALLBACK_SECRET=change-me
DEMO_GUIDES_CALLBACK_SECRET=change-me
DEMO_RENTALS_CALLBACK_SECRET=change-me
